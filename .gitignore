*
!.gitignore
!kitty/
!kitty/**
!niri/
!niri/**
!nvim/
!nvim/**
!tmux/
!tmux/**
!herdr/
!herdr/**
!herdr-resurrect/
!herdr-resurrect/**

# niri backups
niri/*.bak
niri/*.backup*

# tmux: vendored plugin checkouts (installed via tpm)
tmux/plugins/

# kitty: generated theme + backup
kitty/current-theme.conf
kitty/kitty.conf.bak

# nvim: auto-saved session files
**/Session.vim
